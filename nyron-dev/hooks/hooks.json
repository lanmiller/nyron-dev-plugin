{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\" code-policy cat \"${CLAUDE_PLUGIN_ROOT}/hooks/code-policy.md\""
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\" version-check sh \"${CLAUDE_PLUGIN_ROOT}/hooks/version-check.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hub/hub-rearm.sh\" hook"
          }
        ]
      }
    ]
  }
}
